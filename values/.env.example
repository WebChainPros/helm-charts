# Copy this file to .env and fill in actual values
# .env is git-ignored and should never be committed

# External Besu node RPC endpoint host (IP or hostname)
BESU_EXTERNAL_HOST=192.168.1.100

# Blockchain network chain ID
METANET_CHAIN_ID=12345

# Custom evmconnect image tag pushed to GHCR
GHCR_IMAGE_TAG=v1.0.0

# Kubernetes namespace to deploy into
K8S_NAMESPACE=firefly
